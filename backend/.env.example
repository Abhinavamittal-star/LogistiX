PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/logistics?retryWrites=true&w=majority
# Optional resolver override for local environments where MongoDB SRV lookups fail.
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
NODE_ENV=development
DEMO_MODE=false
FRONTEND_URL=http://localhost:5173
SIMULATOR_TOKEN=
# Required to enable self-registration for MongoDB-backed dispatcher accounts.
# Use a long random value and share it only with trusted dispatchers.
DISPATCHER_REGISTRATION_CODE=
